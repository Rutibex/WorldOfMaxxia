{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxxia.invalid/contracts/mp01/pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "maxxia-pack"
    },
    "formatVersion": {
      "const": 1
    },
    "packId": {
      "$ref": "common.schema.json#/$defs/namespace"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "kind": {
      "enum": [
        "core",
        "adventure",
        "content"
      ]
    },
    "engine": {
      "$ref": "common.schema.json#/$defs/range"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_]{0,47}:rules:[a-z][a-z0-9_]{0,79}$"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "packId": {
            "$ref": "common.schema.json#/$defs/namespace"
          },
          "versions": {
            "$ref": "common.schema.json#/$defs/range"
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": [
          "packId",
          "versions",
          "optional"
        ]
      },
      "minItems": 0,
      "maxItems": 128
    },
    "contentIndex": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/path"
        },
        {
          "pattern": "\\.json$",
          "type": "string"
        }
      ]
    },
    "entry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mapId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "arrivalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-z][a-z0-9_]{0,79}$"
            }
          },
          "required": [
            "mapId",
            "arrivalId"
          ]
        }
      ]
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "format",
    "formatVersion",
    "packId",
    "title",
    "version",
    "kind",
    "engine",
    "rules",
    "dependencies",
    "contentIndex",
    "entry",
    "credits"
  ]
}
