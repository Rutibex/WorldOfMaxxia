{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witchesmirror.example/contracts/maxxia-map-document-v1.schema.json",
  "title": "Maxxia map document v1 (MM16)",
  "description": "Native authoring format. Structural cross-references and geometry/object collision are additionally validated by the canonical TypeScript runtime.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "width",
    "height",
    "geometry",
    "materials",
    "scenery",
    "objects",
    "arrivals",
    "events",
    "settings"
  ],
  "properties": {
    "format": {
      "const": "maxxia-map"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^map_[a-z0-9_]{1,91}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "width": {
      "type": "integer",
      "minimum": 3,
      "maximum": 64
    },
    "height": {
      "type": "integer",
      "minimum": 3,
      "maximum": 64
    },
    "geometry": {
      "type": "object",
      "required": [
        "rows"
      ],
      "additionalProperties": true,
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[#.D]{3,64}$"
          }
        }
      }
    },
    "materials": {
      "type": "object",
      "required": [
        "floor",
        "wall",
        "ceiling"
      ],
      "additionalProperties": true,
      "properties": {
        "floor": {
          "$ref": "#/$defs/materialLayer"
        },
        "wall": {
          "$ref": "#/$defs/materialLayer"
        },
        "ceiling": {
          "$ref": "#/$defs/materialLayer"
        }
      }
    },
    "scenery": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object"
      }
    },
    "objects": {
      "type": "object",
      "required": [
        "doors",
        "secrets",
        "traps",
        "fountains",
        "portals"
      ],
      "additionalProperties": true,
      "properties": {
        "doors": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object"
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object"
          }
        },
        "traps": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object"
          }
        },
        "fountains": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object"
          }
        },
        "portals": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/portal"
          }
        }
      }
    },
    "arrivals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/arrival"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/eventPlaceholder"
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "environmentId",
        "notes"
      ],
      "properties": {
        "environmentId": {
          "$ref": "#/$defs/identifier"
        },
        "musicId": {
          "$ref": "#/$defs/identifier"
        },
        "notes": {
          "type": "string",
          "maxLength": 4096
        }
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "additionalProperties": true
    },
    "materialOverride": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "x",
        "y",
        "materialId"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "materialId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "materialLayer": {
      "type": "object",
      "required": [
        "default",
        "overrides"
      ],
      "additionalProperties": true,
      "properties": {
        "default": {
          "$ref": "#/$defs/identifier"
        },
        "overrides": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/materialOverride"
          }
        }
      }
    },
    "arrival": {
      "type": "object",
      "required": [
        "id",
        "name",
        "x",
        "y",
        "facing"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "facing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "eventPlaceholder": {
      "type": "object",
      "required": [
        "id",
        "name",
        "notes",
        "x",
        "y"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 4096
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "x",
        "y",
        "targetMapId",
        "targetX",
        "targetY",
        "targetFacing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,48}$"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "targetMapId": {
          "type": "string",
          "pattern": "^map_[a-z0-9_]{1,91}$"
        },
        "targetX": {
          "$ref": "#/$defs/coordinate"
        },
        "targetY": {
          "$ref": "#/$defs/coordinate"
        },
        "targetFacing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "targetArrivalId": {
          "$ref": "#/$defs/identifier"
        },
        "activation": {
          "type": "string",
          "enum": [
            "interact",
            "step"
          ]
        }
      }
    }
  }
}
