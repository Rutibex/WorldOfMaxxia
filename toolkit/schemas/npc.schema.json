{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxxia.invalid/toolkit/mp14/npc.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "maxxia-authored-npc"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "dialogueId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "initialAttitude": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "services": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "shop"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "condition": {
                    "$ref": "https://maxxia.invalid/toolkit/mp12/routine.schema.json#/$defs/condition"
                  },
                  "minAttitude": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "stock": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "properties": {
                        "itemId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000
                        },
                        "price": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "itemId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "generic": {
                    "type": "object",
                    "properties": {
                      "tags": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "maxItems": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 32
                      }
                    },
                    "required": [
                      "tags",
                      "quantity",
                      "maxItems"
                    ],
                    "additionalProperties": false
                  },
                  "buybackPercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "name",
                  "stock"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "healing"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "condition": {
                    "$ref": "https://maxxia.invalid/toolkit/mp12/routine.schema.json#/$defs/condition"
                  },
                  "minAttitude": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "cost": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "name",
                  "cost",
                  "amount"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "training"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "condition": {
                    "$ref": "https://maxxia.invalid/toolkit/mp12/routine.schema.json#/$defs/condition"
                  },
                  "minAttitude": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "tribute"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "condition": {
                    "$ref": "https://maxxia.invalid/toolkit/mp12/routine.schema.json#/$defs/condition"
                  },
                  "minAttitude": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "cost": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "attitudeDelta": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "once": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "name",
                  "cost",
                  "attitudeDelta"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "barter"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "condition": {
                    "$ref": "https://maxxia.invalid/toolkit/mp12/routine.schema.json#/$defs/condition"
                  },
                  "minAttitude": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "offers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 24
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "give": {
                          "type": "array",
                          "maxItems": 8,
                          "items": {
                            "type": "object",
                            "properties": {
                              "itemId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              },
                              "count": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 20
                              }
                            },
                            "required": [
                              "itemId",
                              "count"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "receive": {
                          "type": "array",
                          "maxItems": 8,
                          "items": {
                            "type": "object",
                            "properties": {
                              "itemId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              },
                              "count": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 20
                              }
                            },
                            "required": [
                              "itemId",
                              "count"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "costGold": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "once": {
                          "type": "boolean"
                        },
                        "attitudeDelta": {
                          "type": "integer",
                          "minimum": -100,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "give",
                        "receive",
                        "costGold"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "name",
                  "offers"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "dialogueId",
        "initialAttitude",
        "services"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "record"
  ],
  "additionalProperties": false
}
