{
  "format": "maxxia-authored-routine",
  "formatVersion": 2,
  "id": "bell:routine:valve_intake",
  "parameters": {},
  "actions": [
    {
      "op": "if",
      "condition": {
        "op": "eq",
        "left": {
          "query": "state",
          "address": {
            "scope": "campaign"
          },
          "kind": "flag",
          "key": "bell:flag:valves"
        },
        "right": true
      },
      "then": [
        {
          "op": "message",
          "text": "The valves are already aligned."
        }
      ],
      "else": [
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "query": "state",
              "address": {
                "scope": "campaign"
              },
              "kind": "counter",
              "key": "bell:counter:valve_step"
            },
            "right": 0
          },
          "then": [
            {
              "op": "state",
              "kind": "counter",
              "address": {
                "scope": "campaign"
              },
              "key": "bell:counter:valve_step",
              "value": 1
            },
            {
              "op": "message",
              "text": "Valve accepted: intake."
            }
          ],
          "else": [
            {
              "op": "cost",
              "damage": 1,
              "minutes": 1
            },
            {
              "op": "if",
              "condition": {
                "op": "eq",
                "left": {
                  "query": "state",
                  "address": {
                    "scope": "campaign"
                  },
                  "kind": "counter",
                  "key": "bell:counter:valve_step"
                },
                "right": 1
              },
              "then": [
                {
                  "op": "state",
                  "kind": "counter",
                  "address": {
                    "scope": "campaign"
                  },
                  "key": "bell:counter:valve_step",
                  "value": -1
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "condition": {
                "op": "eq",
                "left": {
                  "query": "state",
                  "address": {
                    "scope": "campaign"
                  },
                  "kind": "counter",
                  "key": "bell:counter:valve_step"
                },
                "right": 2
              },
              "then": [
                {
                  "op": "state",
                  "kind": "counter",
                  "address": {
                    "scope": "campaign"
                  },
                  "key": "bell:counter:valve_step",
                  "value": -2
                }
              ],
              "else": []
            },
            {
              "op": "message",
              "text": "A recoverable pressure burst deals1 damage to each active hero. All valves reset. Read the inscription: Intake, Return, Bell."
            }
          ]
        }
      ]
    }
  ]
}
