{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxxia.invalid/toolkit/mp20/race.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "maxxia-authored-race"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}:race:[a-z][a-z0-9_]{0,79}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}:race:[a-z][a-z0-9_]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1500
        },
        "attributeBonuses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "STR": {
              "type": "integer",
              "minimum": -3,
              "maximum": 3
            },
            "DEX": {
              "type": "integer",
              "minimum": -3,
              "maximum": 3
            },
            "CON": {
              "type": "integer",
              "minimum": -3,
              "maximum": 3
            },
            "INT": {
              "type": "integer",
              "minimum": -3,
              "maximum": 3
            },
            "WIS": {
              "type": "integer",
              "minimum": -3,
              "maximum": 3
            },
            "CHA": {
              "type": "integer",
              "minimum": -3,
              "maximum": 3
            }
          }
        },
        "resistances": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "physical": {
              "type": "integer",
              "minimum": -25,
              "maximum": 25
            },
            "fire": {
              "type": "integer",
              "minimum": -25,
              "maximum": 25
            },
            "cold": {
              "type": "integer",
              "minimum": -25,
              "maximum": 25
            },
            "lightning": {
              "type": "integer",
              "minimum": -25,
              "maximum": 25
            },
            "poison": {
              "type": "integer",
              "minimum": -25,
              "maximum": 25
            },
            "arcane": {
              "type": "integer",
              "minimum": -25,
              "maximum": 25
            },
            "holy": {
              "type": "integer",
              "minimum": -25,
              "maximum": 25
            },
            "necrotic": {
              "type": "integer",
              "minimum": -25,
              "maximum": 25
            }
          }
        },
        "traits": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}:[a-z][a-z0-9_]{0,47}:[a-z][a-z0-9_]{0,79}$"
          }
        },
        "abilityGrants": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}:ability:[a-z][a-z0-9_]{0,79}$"
              },
              "minLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "id",
              "minLevel"
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "record"
  ]
}
