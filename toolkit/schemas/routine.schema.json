{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxxia.invalid/toolkit/mp02/routine.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "maxxia-authored-routine"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{0,47}:(map|routine):[a-z][a-z0-9_]{0,79}$"
    },
    "actions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "message"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "operation",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "set_flag"
              },
              "flag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_]{0,79}$"
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "operation",
              "flag",
              "value"
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "actions"
  ]
}
