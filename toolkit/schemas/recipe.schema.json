{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxxia.invalid/toolkit/mp21/recipe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "maxxia-authored-recipe"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}:recipe:[a-z][a-z0-9_]{0,79}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}:recipe:[a-z][a-z0-9_]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "station": {
          "enum": [
            "field",
            "workshop"
          ]
        },
        "minLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "ingredients": {
          "$ref": "#/$defs/itemCounts"
        },
        "results": {
          "$ref": "#/$defs/itemCounts"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "station",
        "ingredients",
        "results"
      ]
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "record"
  ],
  "$defs": {
    "itemCounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}:item:[a-z][a-z0-9_]{0,79}$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "itemId",
          "count"
        ]
      }
    }
  }
}
