{
  "name": "maxxia-maker-workspace",
  "version": "0.27.0-mp27",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup:game": "npm --prefix engine/world-of-maxxia ci",
    "check:game": "npm --prefix engine/world-of-maxxia run check",
    "test:game": "node --experimental-strip-types --test engine/world-of-maxxia/tests/*.test.mjs",
    "build:game": "npm --prefix engine/world-of-maxxia run build:offline",
    "build:game:vite": "npm --prefix engine/world-of-maxxia run build -- --outDir ../../artifacts/vite-game",
    "start:game": "node engine/world-of-maxxia/server.mjs",
    "verify:game": "npm --prefix engine/world-of-maxxia run verify:build",
    "check:workspace": "node tools/verify-workspace.mjs",
    "build:editor": "dotnet build editor/MaxxiaMaker.sln -c Release --disable-build-servers -m:1",
    "publish:editor": "dotnet publish editor/MaxxiaMaker.WinForms/MaxxiaMaker.WinForms.csproj -c Release -r win-x64 --self-contained true -o artifacts/editor-win-x64 --disable-build-servers -m:1",
    "generate:contracts": "node tools/generate-contracts.mjs",
    "check:generated": "node tools/generate-contracts.mjs --check",
    "check:contracts": "node --experimental-strip-types tools/check-contracts.mjs",
    "check": "npm run check:generated && npm run check:contracts && npm run check:documents && npm run check:game && npm run check:workspace",
    "verify:project-browser": "node tools/verify-project-browser.mjs",
    "check:art-source": "node --experimental-strip-types --test engine/world-of-maxxia/tests/source-art.optional.mjs",
    "check:documents": "node tools/check-documents.mjs",
    "verify:build-hygiene": "node tools/verify-build-hygiene.mjs",
    "check:resources": "node --experimental-strip-types tools/check-resources.mjs",
    "migrate:map": "node --experimental-strip-types tools/migrate-maps-mm16.mjs",
    "check:mp01": "node tools/check-mp01.mjs",
    "generate:pack-types:mp01": "node tools/generate-pack-types-mp01.mjs",
    "maxxia": "node tools/maxxia.mjs",
    "check:mp02": "node tools/check-mp02.mjs",
    "generate:toolkit-reference": "node tools/generate-toolkit-reference.mjs",
    "check:mp03": "node tools/check-mp03.mjs",
    "check:mp04": "node tools/check-mp04.mjs",
    "verify:catalogue-browser:mp04": "node tools/verify-catalogue-browser-mp04.mjs",
    "check:mp05": "node tools/check-mp05.mjs",
    "check:mp07": "node --experimental-strip-types --test engine/world-of-maxxia/tests/campaign-instances-mp07.test.mjs",
    "check:mp06": "node --experimental-strip-types --test engine/world-of-maxxia/tests/pack-library.test.mjs",
    "generate:proof:mp06": "node tools/build-mp06-catalogue.mjs",
    "check:mp08": "node --experimental-strip-types --test engine/world-of-maxxia/tests/portable-roster-mp08.test.mjs",
    "check:mp10": "node --experimental-strip-types --test engine/world-of-maxxia/tests/catalogue-upgrades-mp10.test.mjs",
    "check:mp11": "node --experimental-strip-types --test engine/world-of-maxxia/tests/simulation-mp11.test.mjs && node --experimental-strip-types tools/run-mp11-scenario.mjs examples/mp11/basic-commands.json",
    "check:mp12": "node --experimental-strip-types --test engine/world-of-maxxia/tests/routines-mp12.test.mjs && node --experimental-strip-types tools/routines-mp12.mjs examples/mp12/lever-routines.json --proof",
    "check:mp13": "node --experimental-strip-types --test engine/world-of-maxxia/tests/objects-mp13.test.mjs && node --experimental-strip-types tools/run-mp13-scenario.mjs",
    "check:mp14": "node --experimental-strip-types --test engine/world-of-maxxia/tests/social-mp14.test.mjs && node --experimental-strip-types tools/run-mp14-scenario.mjs",
    "check:mp15": "node --experimental-strip-types --test engine/world-of-maxxia/tests/quest-engine-mp15.test.mjs && node --experimental-strip-types tools/run-mp15-scenarios.mjs",
    "check:mp16": "node --experimental-strip-types --test engine/world-of-maxxia/tests/encounter-director-mp16.test.mjs && node --experimental-strip-types tools/run-mp16-scenarios.mjs",
    "check:mp17": "node --experimental-strip-types --test engine/world-of-maxxia/tests/brass-bell-mp17.test.mjs && node --experimental-strip-types tools/run-mp17-scenarios.mjs",
    "check:mp18": "node --experimental-strip-types --test engine/world-of-maxxia/tests/effects-mp18.test.mjs && node --experimental-strip-types tools/run-mp18-scenarios.mjs",
    "check:mp19": "node tools/build-mp19-catalogues.mjs && node --experimental-strip-types --test engine/world-of-maxxia/tests/abilities-mp19.test.mjs",
    "run:mp19": "node --experimental-strip-types tools/run-mp19-scenarios.mjs --production",
    "check:mp20": "node tools/build-mp20-catalogues.mjs && node --experimental-strip-types --test engine/world-of-maxxia/tests/creation-mp20.test.mjs",
    "run:mp20": "node --experimental-strip-types tools/run-mp20-scenarios.mjs --production",
    "build:mp21:catalogues": "node tools/build-mp21-catalogues.mjs",
    "check:mp21": "node --experimental-strip-types --test engine/world-of-maxxia/tests/equipment-mp21.test.mjs",
    "run:mp21": "node --experimental-strip-types tools/run-mp21-scenarios.mjs --production",
    "check:mp22": "node --experimental-strip-types --test engine/world-of-maxxia/tests/monsters-mp22.test.mjs",
    "build:mp22:catalogues": "node tools/build-mp22-catalogues.mjs",
    "run:mp22": "node --experimental-strip-types tools/run-mp22-scenarios.mjs --production",
    "check:mp23": "node tools/build-mp23-catalogues.mjs && node --experimental-strip-types --test engine/world-of-maxxia/tests/exploration-mp23.test.mjs",
    "build:mp23:catalogues": "node tools/build-mp23-catalogues.mjs",
    "run:mp23": "node --experimental-strip-types tools/run-mp23-scenarios.mjs --production",
    "check:mp24": "node --experimental-strip-types --test engine/world-of-maxxia/tests/scene-profiles-mp24.test.mjs toolkit/tests/mp24.test.mjs",
    "build:mp24:catalogues": "node tools/build-mp24-catalogues.mjs",
    "run:mp24": "node --experimental-strip-types tools/run-mp24-scenarios.mjs --production",
    "check:mp25": "node --experimental-strip-types --test engine/world-of-maxxia/tests/sprites-mp25.test.mjs toolkit/tests/mp25.test.mjs",
    "build:mp25:catalogues": "node tools/build-mp25-catalogues.mjs",
    "run:mp25": "node --experimental-strip-types tools/run-mp25-scenarios.mjs --production",
    "check:mp26": "node --experimental-strip-types --test engine/world-of-maxxia/tests/terrain-mp26.test.mjs toolkit/tests/mp26.test.mjs",
    "build:mp26:catalogues": "node tools/build-mp26-catalogues.mjs",
    "run:mp26": "node --experimental-strip-types tools/run-mp26-scenarios.mjs --production",
    "check:mp27": "node --experimental-strip-types --test engine/world-of-maxxia/tests/perception-mp27.test.mjs toolkit/tests/mp27.test.mjs",
    "build:mp27:catalogues": "node tools/build-mp27-catalogues.mjs",
    "run:mp27": "node --experimental-strip-types tools/run-mp27-scenarios.mjs --production"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "ajv": "8.17.1"
  }
}
