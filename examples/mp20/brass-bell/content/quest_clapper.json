        "title": "Village supply restored",
        "status": "succeeded",
        "ending": {
          "title": "The Village Bell Rings Clear",
          "text": "You replace the clapper and restore the regulator. The village well fills. Edda opens the public water ledger, naming the sabotage, and promises the infirmary a repaired supply line.",
          "campaign": true
        }
      },
      {
        "id": "infirmary",
        "title": "The infirmary awakens",
        "status": "succeeded",
        "ending": {
          "title": "A Bell for the Sick",
          "text": "You replace the clapper and divert the regulator to the abandoned infirmary. Its lamps and sterilizers wake. The village must ration water, but Edda agrees that a living patient matters more than an unbroken custom.",
          "campaign": true
        }
